{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "dos hook session-start --workspace . 2>/dev/null || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "dos hook stop --workspace . 2>/dev/null || true"
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "dos hook stop-failure --success --workspace . 2>/dev/null || true"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "overloaded|server_error|rate_limit",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "timeout": 15,
            "command": "python scripts/rate_limit_rewake.py --workspace . || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python scripts/trajectory_audit.py:*)",
      "Bash(python scripts/git_hygiene.py:*)"
    ]
  }
}
