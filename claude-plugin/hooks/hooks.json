{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/dos-hook\" pretool --workspace . || python -m dos.cli hook pretool --workspace ."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Bash|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/dos-hook\" posttool --workspace . || python -m dos.cli hook posttool --workspace ."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/dos-hook\" stop --workspace . || python -m dos.cli hook stop --workspace ."
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "python -m dos.cli hook stop-failure --success --workspace . 2>/dev/null || true"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "asyncRewake": true,
            "rewakeMessage": "Session resumed after an API failure (rate limit / overload). DOS breaker state:",
            "rewakeSummary": "API-failure backoff retry",
            "timeout": 320,
            "command": "python -m dos.cli hook stop-failure --workspace ."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/dos-hook\" stop --workspace . || python -m dos.cli hook stop --workspace ."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python -m dos.cli hook marker --reset --workspace ."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/bin/dos-hook\" session-start --workspace . || python -m dos.cli hook session-start --workspace ."
          }
        ]
      }
    ]
  }
}
